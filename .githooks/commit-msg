#!/bin/sh
msg_file="$1"
if grep -Eiq '^[[:space:]]*Co-authored-by:[[:space:]]*Cursor' "$msg_file" \
  || grep -Eiq '^[[:space:]]*Made-with:[[:space:]]*Cursor' "$msg_file"; then
  echo "ERROR: Cursor trailer detected in commit message." >&2
  echo "Remove lines like 'Co-authored-by: Cursor ...' or 'Made-with: Cursor'." >&2
  exit 1
fi
exit 0