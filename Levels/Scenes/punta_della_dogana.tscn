[node name="Interactions" type="Node2D" parent="Gameplay" groups=["dogana_interactions"]]

[node name="RegistroMerci" parent="Gameplay/Interactions" instance=ExtResource("32_lore_lectern")]
position = Vector2(2430, 434)
entry_title = "Registro delle merci sommerse"
entry_text = "Anno 1631. Le navi in quarantena scaricarono sale, spezie e una cassa senza sigillo. Il doganiere che la aprì annotò soltanto: 'il mare era già dentro'. La riga successiva è stata cancellata con cera turchese."

[node name="LibroLonghena" parent="Gameplay/Interactions" instance=ExtResource("32_lore_lectern")]
position = Vector2(4050, 435)
scale = Vector2(0.92, 0.92)
entry_title = "Taccuino di Baldassare"
entry_text = "La Salute non guarda la Punta: la trattiene. Otto lati, otto spinte contro l'acqua. Fra i conti della fabbrica compare ogni mese una voce impossibile: 'una campana restituita dalla laguna'."

[node name="MessaleCustode" parent="Gameplay/Interactions" instance=ExtResource("32_lore_lectern")]
position = Vector2(4380, -500)
scale = Vector2(0.9, 0.9)
entry_title = "Messale del custode"
entry_text = "Chi attraversa la Dogana paga in moneta. Chi attraversa la Salute paga in memoria. Sotto l'ultima frase qualcuno ha disegnato un piccolo gamberetto con una corona troppo grande."
enabled_region = "interior"

[node name="SaluteVista" type="Area2D" parent="Gameplay/Interactions" groups=["dogana_interactable"]]
position = Vector2(280, 430)
collision_layer = 0
collision_mask = 2
metadata/prompt = "Guarda verso la Salute"
metadata/action = "lore"
metadata/message = "\"Santa Maria della Salute: cupola ottagonale di Longhena. Il Custode attende nella nave — oltre la Torre della Fortuna, dentro la basilica.\""

