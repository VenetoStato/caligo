data_*/
mono_crash.*.json

# System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
*.log

# Backup files
*.bak
*.backup
*~

# Godot 4 specific
.godot/

# Android build output
android/build/
build/
*.apk

# Artist drop working copies (seeded from live art; sync back with tools/sync_artist_drop.py)
Landscape/Dogana/ArtistDrop/*.png
Landscape/Dogana/ArtistDrop/*.jpg
Landscape/Dogana/ArtistDrop/*.psd
Landscape/Dogana/ArtistDrop/*.psb
Landscape/Dogana/ArtistDrop/BOARD.html

# Local test redirects
_t_out.txt
_t_err.txt
_guided_out.txt
_guided_err.txt
tools/__pycache__/
tmp/
zone_out.txt
zone_err.txt
Landscape/Dogana/ArtistDrop/*.import
